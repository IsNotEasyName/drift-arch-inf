# Конфигурация SFWBar для DriftArchInf
# Панель внизу экрана
bar {
    position = bottom
    height = 48
    monitor = "*"
    css = "* { background: rgba(30, 30, 30, 0.95); border-radius: 12px; margin: 4px; }"
}

# Кнопка "Все приложения" (открывает nwg-drawer)
button {
    icon = "view-app-grid-symbolic"
    action = "exec nwg-drawer -ovl -nofs"
    tooltip = "Все приложения"
}

# Закреплённые приложения (запускаются всегда)
launcher {
    icon = "firefox"
    action = "exec firefox"
}
launcher {
    icon = "org.gnome.Terminal"
    action = "exec foot"
}
launcher {
    icon = "org.gnome.Nautilus"
    action = "exec thunar"
}

# Задачи (запущенные приложения)
taskbar {
    show_icons = true
    show_title = false
}
